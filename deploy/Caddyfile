{
	auto_https off
	admin off
}

:80 {
	root * /srv

	# Old single-page URL for the legal page
	redir /legal.html /legal/ permanent

	# Duplicate URLs: /index.html and /<page>/index.html -> the clean URL
	@indexFile path_regexp idx ^(.*/)index\.html$
	redir @indexFile {re.idx.1} permanent

	# The error page itself is not a real page: requesting it directly returns 404, not 200.
	error /404.html 404

	# ---- Funnel events (see docs/measurement.md) ----
	# The container never sees visitor IPs (the edge proxy doesn't forward a trusted
	# client IP) and the filter drops host, IP and header fields, so each line holds
	# only time, method, status and the /e?... URI. Logs live in /root/flirtlessons/logs.
	handle /e {
		respond 204
	}
	@notEvents not path /e
	log_skip @notEvents
	log {
		output file /logs/events.log {
			roll_size 10MiB
			roll_keep 10
		}
		format filter {
			wrap json
			fields {
				request>host delete
				request>remote_ip delete
				request>remote_port delete
				request>client_ip delete
				request>headers delete
				request>tls delete
				resp_headers delete
				user_id delete
			}
		}
	}

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	# styles.css / main.js / challenge.js / quiz.js are always requested with ?v=<content hash>
	@versioned path /styles.css /main.js /challenge.js /quiz.js
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@assets path *.woff2 *.png *.svg *.ico *.webmanifest
	header @assets Cache-Control "public, max-age=2592000"

	@pages not path /styles.css /main.js /challenge.js /quiz.js *.woff2 *.png *.svg *.ico *.webmanifest
	header @pages Cache-Control "public, max-age=300"

	header -Server
}
