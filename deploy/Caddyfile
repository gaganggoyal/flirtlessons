{
	auto_https off
	admin off
}

:80 {
	root * /srv

	# Old single-page URL for the legal page
	redir /legal.html /legal/ permanent

	# Duplicate URLs: /index.html and /<page>/index.html -> the clean URL
	@indexFile path_regexp idx ^(.*/)index\.html$
	redir @indexFile {re.idx.1} permanent

	# ---- Funnel events (OFF until the owner approves; see docs/measurement.md) ----
	# To enable: uncomment this block, mount ./logs:/logs in docker-compose.yml,
	# set ANALYTICS_ENABLED = True in build.py and publish the updated privacy text.
	# The inner container never sees visitor IPs (the edge proxy does not forward a
	# trusted client IP), and the log filter also drops all headers, so the log
	# holds only time, path and the coarse event fields in the query string.
	#
	# handle /e {
	# 	respond 204
	# }
	# @notEvents not path /e
	# log_skip @notEvents
	# log {
	# 	output file /logs/events.log {
	# 		roll_size 10MiB
	# 		roll_keep 10
	# 	}
	# 	format filter {
	# 		wrap json
	# 		fields {
	# 			request>host delete
	# 			request>remote_ip delete
	# 			request>remote_port delete
	# 			request>client_ip delete
	# 			request>headers delete
	# 			request>tls delete
	# 			resp_headers delete
	# 			user_id delete
	# 		}
	# 	}
	# }

	file_server

	handle_errors {
		rewrite * /404.html
		file_server
	}

	# styles.css / main.js / challenge.js are always requested with ?v=<content hash>
	@versioned path /styles.css /main.js /challenge.js
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	@assets path *.woff2 *.png *.svg *.ico *.webmanifest
	header @assets Cache-Control "public, max-age=2592000"

	@pages not path /styles.css /main.js /challenge.js *.woff2 *.png *.svg *.ico *.webmanifest
	header @pages Cache-Control "public, max-age=300"

	header -Server
}
